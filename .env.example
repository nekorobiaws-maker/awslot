# AWSLOT キャラ音声生成の設定サンプル(DESIGN.md 6.7)
#
#   cp awslot/.env.example awslot/.env
#   （値を埋めてから） node scripts/generate-voices.mjs
#
# ★ .env は絶対にコミットしないこと。
#   リポジトリルートの .gitignore に `.env` があるので awslot/.env も除外済み。
#   （awslot/ を単体リポジトリとして切り出す場合は、そちらの .gitignore に `.env` を追加すること）
# ★ このファイル(.env.example)には実際のキーを書かないこと。
# ★ ブラウザ側は生成済みMP3しか読まないので、APIキーがフロントに出ることはない。

# Aivis Cloud の APIキー
# 発行: https://hub.aivis-project.com/ → ログイン → API Keys
AIVIS_CLOUD_API_KEY=

# 幽霊Kiro の音声モデルUUID
# 探し方: https://hub.aivis-project.com/ の Models から声を選び、
#         モデルページのURL末尾（例 .../models/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx）をコピー
# 声の方向性: ふわふわした優しい女の子声（幽霊キャラ）
KIRO_MODEL_UUID=

# サメ ジョージ・ジョーズ・ユージー の音声モデルUUID
# 声の方向性: 低めで荒っぽい兄貴声
GEORGE_MODEL_UUID=
